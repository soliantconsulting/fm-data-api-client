{
  "name": "fm-data-api-client",
  "version": "3.0.2",
  "description": "FileMaker Data API Client",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && rollup -c",
    "lint": "biome check src test",
    "typecheck": "tsc --noEmit",
    "test": "jest test --coverage",
    "prepare": "husky install",
    "format": "biome check --write src test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soliantconsulting/fm-data-api-client.git"
  },
  "files": [
    "dist/**/*"
  ],
  "keywords": [
    "FileMaker",
    "REST",
    "API",
    "Data",
    "Typescript"
  ],
  "author": "Soliant Consulting",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@fetch-mock/jest": "^0.2.20",
    "@js-joda/core": "^6.1.0",
    "@rollup/plugin-typescript": "^8.5.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/jest": "^29.0.0",
    "@types/node": "^22.20.4",
    "@types/sinon": "^10.0.20",
    "fetch-mock": "^12.6.0",
    "husky": "^8.0.1",
    "jest": "^29.0.0",
    "lint-staged": "^17.6.0",
    "rollup": "^2.80.0",
    "sinon": "^14.0.2",
    "ts-jest": "^29.4.14",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@js-joda/core": "^3.0.0 || ^4.0.0 || ^5.0.0 || ^6.1.0"
  },
  "lint-staged": {
    "*.ts": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
