{
  "name": "fm-data-api-client",
  "version": "3.0.1",
  "description": "FileMaker Data API Client",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && rollup -c",
    "lint": "biome check --write",
    "test": "jest test --coverage",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soliantconsulting/fm-data-api-client.git"
  },
  "files": [
    "dist/**/*"
  ],
  "keywords": [
    "FileMaker",
    "REST",
    "API",
    "Data",
    "Typescript"
  ],
  "author": "Soliant Consulting",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@fetch-mock/jest": "^0.2.14",
    "@js-joda/core": "^6.0.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/jest": "^29.0.0",
    "@types/node": "^22.19.21",
    "@types/sinon": "^21.0.1",
    "fetch-mock": "^12.5.1",
    "husky": "^8.0.1",
    "jest": "^29.7.0",
    "lint-staged": "^17.0.7",
    "rollup": "^4.62.0",
    "sinon": "^22.0.0",
    "ts-jest": "^29.4.11",
    "tslib": "^2.8.1",
    "typescript": "~5.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@js-joda/core": "^3.0.0 || ^4.0.0 || ^5.0.0"
  },
  "lint-staged": {
    "*.ts": "biome check --write --no-errors-on-unmatched"
  }
}
